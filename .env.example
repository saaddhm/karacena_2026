# Server
PORT=5000
NODE_ENV=production

# Public HTTPS origins. CLIENT_URL accepts a comma-separated list for CORS.
# API_URL is the externally reachable API origin, without /api.
CLIENT_URL=https://example.com,https://www.example.com
API_URL=https://example.com

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=karacena_2026
DB_USER=karacena
DB_PASSWORD=CHANGE_ME

# Auth
JWT_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS
JWT_EXPIRES_IN=7d

# Admin bootstrap (created on first seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# Payment (CMI)
CMI_MERCHANT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=https://payment.cmi.co.ma/fim/est3Dgate
